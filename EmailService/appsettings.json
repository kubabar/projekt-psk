{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}",
    "VirtualHost": "/",
    "Exchanges": {
      "Notifications": "notifications.exchange",
      "ApiResults": "api.results.exchange"
    },
    "Queues": {
      "Email2FA": "email.2fa.queue",
      "EmailNotifications": "email.notifications.queue",
      "ApiResultsEmail": "api.results.email.queue"
    },
    "RoutingKeys": {
      "Email2FA": "email.2fa",
      "EmailNotifications": "email.notifications"
    }
  },
  "Smtp": {
    "Host": "${SMTP_HOST}",
    "Port": "${SMTP_PORT}",
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "FromEmail": "${SMTP_FROM_EMAIL}",
    "FromName": "Auth System",
    "EnableSsl": true
  }
}
